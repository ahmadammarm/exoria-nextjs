# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Replace 'postgres', 'password', and 'exoria' with your local credentials.
# If you are using a local Postgres app (like Postgres.app or pgAdmin), 
# ensure the database exists before running migrations.

POSTGRES_PRISMA_URL="postgresql://postgres:password@localhost:5432/exoria?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:password@localhost:5432/exoria?schema=public"

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth)
# -----------------------------------------------------------------------------
# You can generate a new secret using: openssl rand -base64 32
NEXTAUTH_SECRET="local_development_secret_only_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# VERCEL BLOB (For Image Uploads)
# -----------------------------------------------------------------------------
# If you don't have a token, image uploads to Vercel Blob will fail.
# For local dev, you can use a mock or a development-specific token from Vercel.
BLOB_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV="development"
